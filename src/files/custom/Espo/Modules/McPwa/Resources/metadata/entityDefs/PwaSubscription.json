{
    "fields": {
        "name": {
            "type": "varchar",
            "maxLength": 150,
            "readOnly": true
        },
        "user": {
            "type": "link",
            "readOnly": true
        },
        "endpoint": {
            "type": "text",
            "readOnly": true,
            "onlyAdmin": true
        },
        "publicKey": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true,
            "onlyAdmin": true
        },
        "authKey": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true,
            "onlyAdmin": true
        },
        "platform": {
            "type": "varchar",
            "maxLength": 60,
            "readOnly": true
        },
        "userAgent": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "endpointHash": {
            "type": "varchar",
            "maxLength": 64,
            "readOnly": true,
            "onlyAdmin": true,
            "index": false,
            "utility": true
        },
        "lastTestAt": {
            "type": "datetime",
            "readOnly": true,
            "onlyAdmin": true,
            "utility": true
        },
        "lastSuccessAt": {
            "type": "datetime",
            "readOnly": true
        },
        "lastErrorAt": {
            "type": "datetime",
            "readOnly": true
        },
        "lastError": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "failureCount": {
            "type": "int",
            "min": 0,
            "default": 0,
            "readOnly": true
        }
