{
  "name": "mc-pwa",
  "version": "1.3.3",
  "description": "Installable mobile/desktop app with notifications, shortcuts and anonymous statistics.",
  "scripts": {
    "sa": "vendor/bin/phpstan",
    "unit-tests": "vendor/bin/phpunit",
    "integration-tests": "node build --copy && node build --composer-install && cd site && php vendor/bin/phpunit tests/integration/Espo/Modules/McPwa",
    "copy": "node build --copy",
    "composer-install": "node build --composer-install",
    "sync": "node build --copy && node build --composer-install",
    "extension": "node build --extension",
    "clear-cache": "php site/clear_cache.php",
    "rebuild": "node build --rebuild",
    "all": "node build --all",
    "prepare-test": "node build --prepare-test"
  },
  "type": "module",
  "author": "bshumylo",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "espo-extension-tools": "github:espocrm/extension-tools#0.4.6",
    "fs-extra": "^11.4.1"
  },
  "engines": {
    "npm": ">=8",
    "node": ">=18"
  }
}
